# ============================================================
# Synseafy (Next.js Frontend) — Environment Variables Template
# Copy this file to `.env` or `.env.local` and adjust values.
# ============================================================

# --- App Config ---
NEXT_PUBLIC_APP_NAME=Synseafy
# Local: http://localhost:3000 | Production: https://music.wynnsea.my.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- FastAPI Backend Connection (YouTube Music / ytmusicapi) ---
# Jalankan backend: lihat backend/README.md
# Local: http://localhost:8000 | Production: https://api.music.wynnsea.my.id
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# "true" = katalog contoh offline (tanpa backend, tanpa audio);
# "false" / kosong = katalog asli YouTube Music + pemutar YouTube
NEXT_PUBLIC_USE_MOCK_DATA=false

# --- Auth & Google OAuth (ready for backend / NextAuth / Supabase Auth) ---
# Local: http://localhost:3000/auth/callback | Production: https://music.wynnsea.my.id/auth/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server-Only (Next.js Server Components / API Proxy Routes) ---
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
BACKEND_API_KEY=

# --- Supabase (database user: profil, playlist, like, riwayat putar) ---
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Publishable key (sb_publishable_...) aman di browser; data dilindungi Row Level Security
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) melewati RLS: HANYA untuk server, jangan pernah diberi prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
