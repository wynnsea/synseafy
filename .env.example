# ============================================================
# Synseafy (Next.js Frontend) — Environment Variables Template
# Copy this file to `.env` or `.env.local` and adjust values.
# ============================================================

# --- App Config ---
NEXT_PUBLIC_APP_NAME=Synseafy
# Local: http://localhost:3000 | Production: https://music.wynnsea.my.id
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- FastAPI Backend Connection (YouTube Music / ytmusicapi) ---
# Local: http://localhost:8000 | Production: https://api.music.wynnsea.my.id
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Toggle data mode: "true" untuk pakai Mock UI data, "false" untuk konek ke FastAPI live
NEXT_PUBLIC_USE_MOCK_DATA=true

# --- Auth & Google OAuth (ready for backend / NextAuth / Supabase Auth) ---
# Local: http://localhost:3000/auth/callback | Production: https://music.wynnsea.my.id/auth/callback
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Server-Only (Next.js Server Components / API Proxy Routes) ---
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
BACKEND_API_KEY=

# --- Optional: Database Cloud (Supabase — jika tidak pakai SQLite lokal) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
